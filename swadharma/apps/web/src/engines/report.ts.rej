+// Calculate specific profile based on categories
+function computeSpecificDoshaProfile(answers: Record<string, string | string[]>, categoryIds: string[]): DoshaProfile {
+  const targetQuestions = categories
+    .filter(cat => categoryIds.includes(cat.id))
+    .flatMap(cat => cat.questions);
+
+  const specificObservations: Record<string, number> = {};
+  
+  targetQuestions.forEach(q => {
+    const answer = answers[q.id];
+    if (answer) {
+      const obs = getObservationsForAnswer(q, answer);
+      Object.entries(obs).forEach(([key, weight]) => {
+        specificObservations[key] = (specificObservations[key] || 0) + weight;
+      });
+    }
+  });
+  
+  return computeDoshaProfile(specificObservations);
+}
